# Invoked by GenerateEXWORDPackage.cmake in a separate CMake process.
foreach(V IN ITEMS PKG_SOURCE_D01 PKG_HTML_DIR PKG_DEST PKG_APPID PKG_MODULE PKG_TITLE)
  if(NOT DEFINED ${V})
    message(FATAL_ERROR "PackageEXWORD: Missing ${V}")
  endif()
endforeach()
if(NOT EXISTS "${PKG_SOURCE_D01}")
  message(FATAL_ERROR "PackageEXWORD: Missing D01 file ${PKG_SOURCE_D01}")
endif()
file(GLOB HTML_TEMPLATES "${PKG_HTML_DIR}/*.htm")
if(NOT HTML_TEMPLATES)
  message(FATAL_ERROR "PackageEXWORD: No HTML templates in ${PKG_HTML_DIR}")
endif()
file(MAKE_DIRECTORY "${PKG_DEST}")
configure_file("${PKG_SOURCE_D01}" "${PKG_DEST}/${PKG_MODULE}" COPYONLY)
foreach(TEMPLATE IN LISTS HTML_TEMPLATES)
  get_filename_component(NAME "${TEMPLATE}" NAME)
  file(READ "${TEMPLATE}" HTML)
  string(REPLACE "@APPTITLE" "${PKG_TITLE}" HTML "${HTML}")
  string(REPLACE "@APPID" "${PKG_APPID}" HTML "${HTML}")
  string(REPLACE "@APPMOD" "${PKG_MODULE}" HTML "${HTML}")
  # EX-word metadata HTML requires CRLF, including on Linux.
  string(REPLACE "\r\n" "\n" HTML "${HTML}")
  string(REPLACE "\n" "\r\n" HTML "${HTML}")
  file(WRITE "${PKG_DEST}/${NAME}" "${HTML}")
endforeach()
file(WRITE "${PKG_DEST}/fileinfo.cji" "")
